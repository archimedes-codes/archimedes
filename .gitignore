# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
# The shared workspace target dir. The cargo root is the repo root since T4 (the
# root `Cargo.toml` holds the `[workspace]`), so `target/` lives here, not under
# `src-tauri/`. `src-tauri/.gitignore` keeps its own `/target/` rule on purpose: a
# stray `cd src-tauri && cargo build` (still legal — it is a member) recreates a
# nested target dir, and that rule is what keeps it ignored.
/target
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# The junit report CI's `pnpm test` step writes (`--outputFile`); produced locally
# by the same command, and never a file anyone wants to commit.
vitest-results.xml

docs/roadmap/

# local scratch
.research/
# The review workflow's scratch dir (`$PWD/.tmp`: test scratch, Tailwind probes).
# Ignored because Tailwind v4's source detection scans it: a probe file here
# compiles into the shipped CSS (`dist/assets/index-*.css`) unless gitignored.
.tmp/
